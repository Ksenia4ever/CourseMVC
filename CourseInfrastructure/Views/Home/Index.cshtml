@{
    ViewData["Title"] = "Головна";
}

<div class="text-center">
    <h1 class="display-4">Система курсів</h1>
    <p>Лабораторна робота 1. Керування курсами, сертифікатами та підписками.</p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <p>Ви увійшли як <strong>@User.Identity.Name</strong></p>

        <form method="post" asp-controller="Account" asp-action="Logout">
            @Html.AntiForgeryToken()
            <input type="submit" value="Вихід" class="btn btn-primary" />
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary me-2">Вхід</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Реєстрація</a>
    }
</div>