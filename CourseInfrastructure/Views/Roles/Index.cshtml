@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Ролі";
}

<h2>Список ролей</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id ролі</th>
            <th>Назва ролі</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Id</td>
                <td>@role.Name</td>
            </tr>
        }
    </tbody>
</table>