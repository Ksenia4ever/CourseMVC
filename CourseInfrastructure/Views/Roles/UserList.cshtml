@model IEnumerable<CourseDomain.Model.User>

@{
    ViewData["Title"] = "Користувачі";
}

<h2>Список користувачів</h2>

<table class="table">
    <thead>
        <tr>
            <th>Ім'я</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>
                    <a class="btn btn-primary btn-sm"
                           asp-action="Edit"
                           asp-route-userId="@user.Id">
                        Змінити ролі
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>