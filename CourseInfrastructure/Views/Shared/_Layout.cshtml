<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Лабораторна робота 1. Курси</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrapOrange.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CourseInfrastructure.styles.css" asp-append-version="true" />

    <style>
            .menu-bold {
                font-weight: 700;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-3">
            <div class="container-fluid">
                <a class="navbar-brand menu-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    Лабораторна робота 1. Курси
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link menu-bold" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link menu-bold" asp-controller="Courses" asp-action="Index">Курси</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link menu-bold" asp-controller="Accounts" asp-action="MyAccount">Акаунт</a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link menu-bold" asp-controller="Accounts" asp-action="Index">Акаунти</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link menu-bold" asp-controller="Certificates" asp-action="MyCertificates">Сертифікати</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link menu-bold" asp-controller="Excercises" asp-action="Index">Завдання</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link menu-bold" asp-controller="Scores" asp-action="Index">Оцінки</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link menu-bold" asp-controller="Home" asp-action="AdminStats">Статистика</a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link menu-bold" asp-controller="Roles" asp-action="UserList">Список користувачів</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link menu-bold" asp-controller="Admin" asp-action="TeacherRequests">Запроси на вчителя</a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-white me-2">@User.Identity.Name</span>

                            <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SystemMessage"] != null)
    {
        <div class="container">
            <div class="alert alert-success mt-2">
                @TempData["SystemMessage"]
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>