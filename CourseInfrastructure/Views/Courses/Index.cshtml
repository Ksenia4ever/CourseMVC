@model IEnumerable<CourseDomain.Model.Course>

@{
    ViewData["Title"] = "Курси";
}

<style>
    .courses-table th {
        vertical-align: top;
        text-align: left;
    }

    .courses-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .courses-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
    }

    .rounded-action-btn {
        border-radius: 20px !important;
        padding: 8px 18px;
    }
</style>

<h1>Курси</h1>

<div class="courses-top-bar">
    <div>
        <p>
            <a asp-action="Create">Create New</a>
        </p>
    </div>

    <div class="courses-actions">
        <a class="btn btn-primary rounded-action-btn"
               asp-area=""
               asp-controller="Courses"
               asp-action="Import">
            Завантажити дані з файлу
        </a>

        <a class="btn btn-primary rounded-action-btn"
               asp-area=""
               asp-controller="Courses"
               asp-action="Export">
            Експортувати дані у файл
        </a>
    </div>
</div>

<table class="table courses-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subject)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Created)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Modified)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Author)
            </th>
            <th>
                Підписка
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Subject)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Created)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Modified)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Author.Name)
                </td>
                <td>
                    @{
                        int? currentAccountId = ViewBag.CurrentAccountId != null
                            ? (int?)ViewBag.CurrentAccountId
                            : null;

                        var isSubscribed = currentAccountId != null &&
                            item.CourseAccounts != null &&
                            item.CourseAccounts.Any(ca => ca.AccountId == currentAccountId);
                    }

                    <form asp-action="ToggleSubscription" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@item.Id" />

                        @if (isSubscribed)
                        {
                            <button type="submit" class="btn btn-danger rounded-action-btn">
                                Ви підписані
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-outline-secondary rounded-action-btn">
                                Підписатися
                            </button>
                        }
                    </form>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>