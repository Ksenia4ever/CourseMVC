@{
    ViewData["Title"] = "Імпорт з Excel";
}

<h1>Імпорт з Excel</h1>

<h3>Оберіть excel-файл для завантаження</h3>

<form asp-action="Import" asp-controller="Courses" method="post" enctype="multipart/form-data" id="frm-excel">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="fileExcel" class="form-label">Завантажте Excel-файл:</label>
        <input type="file" name="fileExcel" id="fileExcel" class="form-control" />
    </div>

    <input type="submit" value="Завантажити" class="btn btn-primary" />
</form>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>